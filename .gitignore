server.log
# No trailing slash: this machine keeps its actual node_modules elsewhere and
# symlinks it in (see .node_modules_store) — a `node_modules/` (trailing-slash)
# pattern only matches real directories, not that symlink, which is exactly how
# it ended up committed and then broke the Railway build (a machine-specific
# symlink target copied verbatim into a Linux build container, colliding with
# npm ci's own node_modules directory at the same path).
node_modules
.env

# pm2 runtime logs — regenerated fresh wherever the app runs, no reason to ship
# megabytes of one machine's log history to every clone (e.g. the cloud VM).
pm2-*.log

# Production frontend build output — generated by `npm run build`, not source.
vite-react-ts-tailwind/dist/
# Large executables
free-money-app.exe
fixed-free-money-app.exe
src/agents/agentManager.js.bak
# Device ID file (generated at runtime)
.device-id
# Vite reads .env from ITS OWN directory at build time and inlines VITE_* vars
# into the bundle. A committed vite-react-ts-tailwind/.env pinning VITE_API_URL to
# localhost silently broke every deployed build for hours — never commit one.
vite-react-ts-tailwind/.env
