# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0
LOG_LEVEL=info
# Only takes effect when NODE_ENV=development — lets requests skip auth entirely.
# Never set true in any environment reachable from the internet.
ALLOW_DEV_AUTH_BYPASS=false
# Used to build return/cancel redirect URLs for Stripe checkout (paymentService.js).
# Only needed if you're using the fiat payment features (see STRIPE_SECRET_KEY below).
BASE_URL=http://localhost:5000

# Optional: powers auto-drafted pitch responses in companyLeadHunter (real Claude API
# cost per draft, capped by COMPANY_LEAD_HUNTER_MAX_AUTO_DRAFTS below) and gigDraftService.
# Leave unset to just skip those specific auto-draft features — nothing else needs this.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/money-maker

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Dashboard login. Both required — the server refuses to serve logins at all if
# either is unset (see authController.js), rather than falling back to any-credentials
# access. ADMIN_PASSWORD_HASH is a bcrypt HASH, never the plaintext password — generate
# one with:
#   node -e "console.log(require('bcrypt').hashSync('yourPasswordHere', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# The dashboard's own 5s auto-refresh fires ~9 requests/cycle (~1600/15min) just from
# being open in one browser tab — keep this well above that or the dashboard will lock
# itself out of its own API within about a minute of normal use.
RATE_LIMIT_MAX_REQUESTS=3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10MB

# Persistence Settings
PERSISTENCE_ENABLED=false

# Agent manager tuning — generally fine to leave at defaults. maxConcurrent caps how
# many agent instances can run at once; the "survival algorithm" weights below (must
# sum to 1.0) feed the OLD simulated-opportunity culling system, separate from the
# REAL-money performanceGovernor further below which judges real P&L instead.
MAX_CONCURRENT=50
SPAWN_DELAY=1000
CLEANUP_INTERVAL=60000
SURVIVAL_THRESHOLD=0.2
ELITE_THRESHOLD=0.1
EVALUATION_INTERVAL=300000
WEIGHT_EARNINGS=0.4
WEIGHT_OPPORTUNITIES=0.3
WEIGHT_SUCCESS_RATE=0.2
WEIGHT_STABILITY=0.1

# Simulated-opportunity system limits (opportunityService.js) — governs the
# fabricated/demo "opportunities" feed, not real trading.
OPPORTUNITY_FREQUENCY=0.3
MAX_OPPORTUNITY_VALUE=1000
MAX_EARNINGS_PER_AGENT_PER_HOUR=10000
MAX_OPPORTUNITIES_PER_AGENT_PER_HOUR=100
MIN_AGENT_LIFETIME=60000

# Cryptocurrency Settings
CRYPTO_ENABLED=true
DEFAULT_CRYPTO_CURRENCY=BNB
# Legacy generic wallet config (cryptocurrency.js) — an HD-wallet/direct-blockchain
# path predating the real Solana/Binance integrations elsewhere in this file. Not
# used by any of the real trading agents; leave disabled unless you specifically
# built something against walletService.js/walletController.js.
WALLET_ENABLED=false
WALLET_MNEMONIC=
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=
WALLET_NETWORK=mainnet
# Fallback USD prices used only when a live price lookup isn't available (fabricated
# wallet display, not real trading — real agents always fetch live prices).
BTC_USD=30000
ETH_USD=2000
BNB_USD=300
CRYPTO_MIN_SEND_AMOUNT=10
CRYPTO_FEE_MODE=network
CRYPTO_REQUIRED_CONFIRMATIONS=1

# Binance Wallet Configuration
# For every agent in this app EXCEPT crossExchangeTransferArbitrage, generate a
# Binance API key with Spot Trading ENABLED and Withdrawals DISABLED — the app
# doesn't need withdrawal permission for anything else, and a trade-only key limits
# the damage if it ever leaks.
# If you DO want to run crossExchangeTransferArbitrage (see its section further
# below), that one agent needs a key with Withdrawals ENABLED too — real money
# irreversibly leaves your account through this key. Strongly recommended: use a
# SEPARATE key just for this (not the one your other agents trade with), restrict it
# by IP if your host has a static IP, and turn on Binance's withdrawal address
# whitelist so it can only ever send to addresses you've pre-approved.
BINANCE_ENABLED=true
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false
# Hard account-wide kill switch for Binance SPOT calls specifically (futures are
# unaffected) — see realTradingService.js. Leave false unless you have a specific
# reason to disable spot entirely while keeping futures/other strategies running.
BINANCE_SPOT_DISABLED=false

# Cryptocurrency Simulation Mode (set to true if you don't have real API keys)
CRYPTO_SIMULATION_MODE=false
CRYPTO_SIMULATION_DELAY_MS=2000
CRYPTO_SIMULATION_SUCCESS_RATE=0.95

# Master switch for ALL live-money code paths (real Binance withdrawals, real DCA orders).
# Must be true AND BINANCE_API_KEY/SECRET must be real (non-placeholder) values before
# any live order or withdrawal can be placed. Leave false to stay fully simulated.
LIVE_TRADING_CONFIRMED=false

# Real Binance Spot DCA agent (only runs live orders if LIVE_TRADING_CONFIRMED=true above)
BINANCE_DCA_SYMBOL=BTCUSDT
BINANCE_DCA_DAILY_USD=5
BINANCE_DCA_BUDGET_CAP_USD=50
BINANCE_DCA_CHECK_INTERVAL_MS=3600000

# Real Binance Simple Earn (flexible) sweeper — no leverage, no directional exposure,
# just subscribes idle spot balance above reserveUsd into the highest-APY flexible
# product (redeemable back to spot any time). Only LIVE_TRADING_CONFIRMED=true is
# required (no separate futures-style opt-in — this never takes a market position).
BINANCE_EARN_ASSET=USDT
BINANCE_EARN_RESERVE_USD=20
BINANCE_EARN_MIN_SUBSCRIBE_USD=5
BINANCE_EARN_CHECK_INTERVAL_MS=21600000

# Real, MARKET-NEUTRAL funding-rate arbitrage (long spot + short perp of matching
# notional — profits from the funding rate itself, not price direction; see
# fundingRateArbitrageAgent.js). Still requires BOTH LIVE_TRADING_CONFIRMED=true AND
# LIVE_FUTURES_TRADING_CONFIRMED=true below, since it does open a real futures
# position as one leg of the hedge, even though the net exposure is designed to be
# directionally flat.
FUNDING_ARB_PER_TRADE_NOTIONAL_USD=20
FUNDING_ARB_FUTURES_LEVERAGE=3
FUNDING_ARB_MARGIN_MODE=ISOLATED
FUNDING_ARB_MIN_RATE_ENTER=0.0003
FUNDING_ARB_MIN_RATE_EXIT=0.0001
FUNDING_ARB_MIN_VOLUME_USD=5000000
FUNDING_ARB_MAX_CANDIDATES_PER_CYCLE=3
FUNDING_ARB_SCAN_INTERVAL_MS=1800000

# Real spot (no leverage) grid trading — profits from range-bound sideways price
# action, not directional moves. Only LIVE_TRADING_CONFIRMED=true required. Leave
# LOWER/UPPER_PRICE unset so the agent auto-computes bounds from recent history on
# first run; set both explicitly only if you want to override that.
GRID_TRADING_SYMBOL=BTCUSDT
GRID_TRADING_LEVELS=10
GRID_TRADING_PER_LEVEL_USD=5
# GRID_TRADING_LOWER_PRICE=
# GRID_TRADING_UPPER_PRICE=
GRID_TRADING_BOUNDS_LOOKBACK_DAYS=90
GRID_TRADING_BOUNDS_PADDING_PCT=0.05
GRID_TRADING_SCAN_INTERVAL_MS=300000

# Second, SEPARATE opt-in required (in addition to LIVE_TRADING_CONFIRMED=true above) before
# the leveraged futures agent can place any order. Leveraged futures can lose more than the
# margin committed if not for the attached stop-loss, and can still lose the full margin to
# liquidation faster than a stop-loss fills during extreme volatility/slippage.
LIVE_FUTURES_TRADING_CONFIRMED=false

# Shared cap across EVERY real futures agent/strategy combined (in addition to each
# agent's own per-agent cap below). Running multiple strategies at once can never push
# total real margin exposure past this number without deliberately raising it.
GLOBAL_FUTURES_BUDGET_CAP_USD=50

# Real Binance USDT-M Futures DCA agent (requires BOTH LIVE_TRADING_CONFIRMED=true AND
# LIVE_FUTURES_TRADING_CONFIRMED=true above). budgetCap is margin committed, not notional
# (leveraged) exposure — actual position size is dailyMarginUsd * leverage.
BINANCE_FUTURES_DCA_SYMBOL=BTCUSDT
BINANCE_FUTURES_DCA_DAILY_MARGIN_USD=5
BINANCE_FUTURES_DCA_BUDGET_CAP_USD=50
BINANCE_FUTURES_DCA_LEVERAGE=50
BINANCE_FUTURES_DCA_MARGIN_MODE=ISOLATED
BINANCE_FUTURES_DCA_STOP_LOSS_PCT=0.01
BINANCE_FUTURES_DCA_TAKE_PROFIT_PCT=0.03
BINANCE_FUTURES_DCA_CHECK_INTERVAL_MS=3600000

# Real, LEVERAGED breakout scanner across ALL USDT-margined futures perpetuals (requires
# BOTH LIVE_TRADING_CONFIRMED=true AND LIVE_FUTURES_TRADING_CONFIRMED=true above).
# budgetCap is a SHARED cap across every symbol this agent ever trades, not per-symbol.
# Signal: last price within NEAR_HIGH_PCT of its own 24h high AND 24h change > MOMENTUM_PCT.
# This is a simple, unvalidated heuristic, not a backtested strategy.
# sizingMode percentOfBalance: each trade risks riskPct of CURRENT available futures
# balance (position size grows with wins, shrinks with losses). BUDGET_CAP_USD is still
# a hard backstop regardless of sizing mode. sizingMode=fixed uses PER_TRADE_MARGIN_USD instead.
BREAKOUT_FUTURES_SIZING_MODE=percentOfBalance
BREAKOUT_FUTURES_RISK_PCT=0.2
BREAKOUT_FUTURES_PER_TRADE_MARGIN_USD=5
BREAKOUT_FUTURES_BUDGET_CAP_USD=50
BREAKOUT_FUTURES_LEVERAGE=50
BREAKOUT_FUTURES_MARGIN_MODE=ISOLATED
BREAKOUT_FUTURES_STOP_LOSS_PCT=0.01
BREAKOUT_FUTURES_TAKE_PROFIT_PCT=0.03
BREAKOUT_FUTURES_NEAR_HIGH_PCT=0.001
BREAKOUT_FUTURES_MOMENTUM_PCT=5
BREAKOUT_FUTURES_MAX_NOTIONAL_PCT_OF_VOLUME=0.005
BREAKOUT_FUTURES_MAX_CANDIDATES_PER_CYCLE=3
BREAKOUT_FUTURES_SCAN_INTERVAL_MS=300000

# Real, LEVERAGED mean-reversion (RSI oversold) scanner (requires BOTH
# LIVE_TRADING_CONFIRMED=true AND LIVE_FUTURES_TRADING_CONFIRMED=true above, and is
# also bound by GLOBAL_FUTURES_BUDGET_CAP_USD shared across all real futures agents).
MEAN_REVERSION_FUTURES_PER_TRADE_MARGIN_USD=5
MEAN_REVERSION_FUTURES_BUDGET_CAP_USD=50
MEAN_REVERSION_FUTURES_LEVERAGE=50
MEAN_REVERSION_FUTURES_MARGIN_MODE=ISOLATED
MEAN_REVERSION_FUTURES_STOP_LOSS_PCT=0.01
MEAN_REVERSION_FUTURES_TAKE_PROFIT_PCT=0.03
MEAN_REVERSION_FUTURES_RSI_PERIOD=14
MEAN_REVERSION_FUTURES_RSI_INTERVAL=1h
MEAN_REVERSION_FUTURES_RSI_OVERSOLD=30
MEAN_REVERSION_FUTURES_MAX_NOTIONAL_PCT_OF_VOLUME=0.005
MEAN_REVERSION_FUTURES_WATCHLIST_SIZE=30
MEAN_REVERSION_FUTURES_MAX_CANDIDATES_PER_CYCLE=2
MEAN_REVERSION_FUTURES_SCAN_INTERVAL_MS=900000

# THIRD, separate opt-in (on top of LIVE_TRADING_CONFIRMED and
# LIVE_FUTURES_TRADING_CONFIRMED above): if true, all real-money trading agents
# (binanceDca, binanceFuturesDca, breakoutFutures, meanReversionFutures) auto-spawn on
# every server start/restart, so they resume automatically after a crash or reboot
# without a human re-triggering them via the API. Leave false unless you specifically
# want unattended 24/7 real trading.
AUTO_SPAWN_REAL_TRADING_AGENTS=false

# Real, HIGH-RISK pump.fun memecoin sniper (requires BOTH LIVE_TRADING_CONFIRMED=true
# AND LIVE_PUMPFUN_TRADING_CONFIRMED=true, plus a real SOLANA_PRIVATE_KEY below).
# Deliberately NOT auto-spawned anywhere — start it explicitly via POST
# /api/agents/spawn when you actually want it running. See pumpFunSniperAgent.js's
# file header for the real risk profile: most pump.fun tokens go to zero as the
# NORMAL outcome, not a tail risk, and this is not comparable to the exchange-traded
# Binance strategies. budgetCapUsd is a hard, permanent, all-time spend ceiling —
# leave PUMPFUN_SNIPER_BUDGET_CAP_USD unset for no separate $ ceiling (the real
# ceiling is then just whatever real SOL the wallet holds), or set a number to add
# an explicit one back on top of that.
LIVE_PUMPFUN_TRADING_CONFIRMED=false
SOLANA_PRIVATE_KEY=your_solana_wallet_private_key_here
# Optional — defaults to Solana's free public mainnet RPC, which rate-limits under
# heavy use. Set a dedicated RPC URL (Helius, QuickNode, etc.) for more reliable
# real-money execution.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PUMPFUN_SNIPER_BUDGET_CAP_USD=10
PUMPFUN_SNIPER_RESERVE_SOL=0.006
PUMPFUN_SNIPER_MAX_SOL_PER_SNIPE=0.05
PUMPFUN_SNIPER_SLIPPAGE_PCT=15
PUMPFUN_SNIPER_PRIORITY_FEE_SOL=0.00005
PUMPFUN_SNIPER_STOP_LOSS_PCT=40
# Trailing stop (2026-09-01, replaced the old flat profit target): once in profit,
# exits when price gives back this much from its peak, instead of always selling at
# a fixed target — lets a real winner keep running. See pumpFunSniperAgent.js.
PUMPFUN_SNIPER_TRAILING_STOP_PCT=20
PUMPFUN_SNIPER_MAX_HOLD_MS=300000
PUMPFUN_SNIPER_PRICE_CHECK_INTERVAL_MS=20000
# Entry filtering (2026-09-01): buys the tokens that show real organic interest
# within a short observation window, instead of literally every new launch. Real
# live pump.fun data sampled while building this: of 3 random real launches, only
# ONE picked up genuine buying (~6.85 real SOL, market cap +50% within minutes);
# the other two sat at near-zero real reserves. minRealSolReservesForEntry sits
# between "dead" (~0) and "clearly working" (~6.85) from that sample — a low bar,
# but a real one.
PUMPFUN_SNIPER_OBSERVATION_WINDOW_MS=10000
PUMPFUN_SNIPER_MIN_REAL_SOL_RESERVES=0.3
PUMPFUN_SNIPER_MAX_CANDIDATE_AGE_MS=120000

# Real HackerOne public bounty-program feed (read-only, no auth, no money risk)
HACKERONE_POLL_INTERVAL_MS=3600000
HACKERONE_MAX_RESULTS=20

# Real Remote OK crypto/web3 job feed (read-only, no auth, no money risk, no auto-apply)
CRYPTO_GIG_HUNTER_POLL_INTERVAL_MS=3600000
CRYPTO_GIG_HUNTER_MAX_RESULTS=20

# Real GitHub paid-bounty issue feed (read-only, no auth, no comment/PR submission)
GITHUB_BOUNTY_POLL_INTERVAL_MS=3600000
GITHUB_BOUNTY_MAX_RESULTS=20

# Real airdrops.io project feed (read-only, no wallet connect, never claims anything —
# surfaces which real airdrops currently exist so you can check eligibility and claim
# manually on the official project site)
AIRDROP_SCANNER_POLL_INTERVAL_MS=3600000
AIRDROP_SCANNER_MAX_RESULTS=20
AIRDROP_SCANNER_MAX_ENRICH=10

# Real CoinGecko trending-coins feed (read-only, keyless) — stand-in for "what's
# spiking in attention right now" (true X/Twitter API access needs a paid dev plan
# this app doesn't have configured)
CRYPTO_UPDATES_POLL_INTERVAL_MS=1800000
CRYPTO_UPDATES_MAX_RESULTS=15

# Read-only "best meme coin traders" leaderboard — judges real on-chain early-buy
# observations (recorded by pumpFunSniperAgent) against real market-cap growth.
# Never trades, never follows a wallet on its own.
SMART_MONEY_RECONCILE_INTERVAL_MS=1800000
SMART_MONEY_MAX_RECONCILE_PER_CYCLE=20
# Optional — richer wallet-activity enrichment via Solana Tracker's API. Leave unset
# to still get the core leaderboard from on-chain observations alone.
SOLANA_TRACKER_API_KEY=your_solana_tracker_api_key_here

# Real Hacker News "Who is hiring?"/"Seeking freelancer?" thread feed (read-only, no
# auth, never posts/replies). maxAutoDraftsPerPoll uses ANTHROPIC_API_KEY above for a
# capped number of auto-drafted pitch responses per poll for you to review manually.
COMPANY_LEAD_HUNTER_POLL_INTERVAL_MS=21600000
COMPANY_LEAD_HUNTER_MAX_RESULTS=10
COMPANY_LEAD_HUNTER_MAX_AUTO_DRAFTS=3

# Real Telegram push notifications (periodic digest + event alerts) — idle, not an
# error, if left unset. Create a bot via @BotFather to get a token, and message the
# bot once (or add it to a group) to find your chat ID.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_DIGEST_INTERVAL_MS=14400000

# Real cross-exchange (Binance/Coinbase/Kraken) spot spread scanner (read-only, no
# auth, no orders on any exchange — see crossExchangeArbitrageAgent.js for why it
# only surfaces candidates instead of executing them). Built on ccxt, the same
# unified exchange library freqtrade (github.com/freqtrade/freqtrade) wraps
# everything around. Quotes are WebSocket-streamed (ccxt.pro, bundled free) rather
# than REST-polled, so SCAN_INTERVAL_MS is just how often the already-live cache is
# checked, not a network-fetch rate — safe to run in the low seconds or faster.
# Taker-fee estimates below are each exchange's lowest-volume-tier default; set them
# to your actual account's fee tier for accurate results.
CROSS_EXCHANGE_ARB_MIN_NET_SPREAD_PCT=0.003
CROSS_EXCHANGE_ARB_MAX_CANDIDATES=10
CROSS_EXCHANGE_ARB_SCAN_INTERVAL_MS=2000
# A live quote older than this is treated as missing rather than trusted (guards
# against a silently-dropped WebSocket still holding a stale last-known price).
CROSS_EXCHANGE_ARB_STALE_QUOTE_MS=15000
ARB_TAKER_FEE_BINANCE=0.001
ARB_TAKER_FEE_COINBASE=0.006
ARB_TAKER_FEE_KRAKEN=0.0026
ARB_TAKER_FEE_BYBIT=0.001
ARB_TAKER_FEE_KUCOIN=0.001
ARB_TAKER_FEE_BITGET=0.001
ARB_TAKER_FEE_GATE=0.002
# Dynamic pairlist settings, ported from freqtrade's VolumePairList (rank by
# quoteVolume, keep top N) + SpreadFilter (reject a quote whose own bid/ask spread
# is already wide) — the watched assets aren't a hardcoded list, they're rebuilt
# from live volume rankings on this interval.
CROSS_EXCHANGE_ARB_NUMBER_ASSETS=15
CROSS_EXCHANGE_ARB_MIN_VOLUME_USD=2000000
CROSS_EXCHANGE_ARB_MAX_SPREAD_RATIO=0.005
CROSS_EXCHANGE_ARB_PAIRLIST_REFRESH_MS=1800000

# ============================================================================
# REAL MONEY, HIGH-RISK: transfer-based cross-exchange arbitrage
# (crossExchangeTransferArbitrageAgent.js). Buys on Binance, WITHDRAWS the real
# crypto to Coinbase, sells there once it lands. NOT auto-spawned on server start
# under any flag (unlike the other real trading agents) — must always be started
# deliberately via POST /api/agents/spawn, every time, including after a restart.
#
# Read this before turning it on: crypto transfers between exchanges take real time
# (10-60+ minutes typically) — the spread this agent measured at buy time can easily
# be gone or reversed by the time the deposit lands on Coinbase, and the withdrawal
# fee is real and non-refundable either way. This is a genuine, acknowledged risk of
# this specific model, not a bug — see the agent's file header for the full
# reasoning and why crossExchangeArbitrage (the read-only scanner) exists separately
# and doesn't do this.
#
# Three independent opt-ins are required before ANY live order or withdrawal fires,
# checked on every call (not just at startup):
#   1. LIVE_TRADING_CONFIRMED=true            (shared with every other real agent)
#   2. LIVE_WITHDRAWAL_CONFIRMED=true          (see realTradingService.js — a
#                                                withdrawal is irreversible if the
#                                                address/network is wrong, so this is
#                                                its own separate flag from #1)
#   3. LIVE_TRANSFER_ARBITRAGE_CONFIRMED=true  (gates the Coinbase sell leg too)
# ...plus real (non-placeholder) BINANCE_API_KEY/SECRET (WITH withdrawal permission
# — see the Binance section above) AND COINBASE_API_KEY/SECRET below.
LIVE_WITHDRAWAL_CONFIRMED=false
LIVE_TRANSFER_ARBITRAGE_CONFIRMED=false

# Generate a Coinbase Advanced Trade / CDP API key with Trading permission. It does
# NOT need withdrawal permission — this agent only ever sells on Coinbase, never
# withdraws from it (see coinbaseTradingService.js's header). Coinbase's key/secret
# format varies by API generation, so unlike Binance's fixed 64-char keys, only
# "non-placeholder" is validated locally — Coinbase's own API is the real check.
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# perTradeUsd: size of each buy on Binance. Keep this small while you build
# confidence in the pipeline — a bad withdrawal-network mistake or a spread that
# fully reverses during transfer is a real loss of this amount.
TRANSFER_ARB_PER_TRADE_USD=25
# Deliberately much higher than CROSS_EXCHANGE_ARB_MIN_NET_SPREAD_PCT above — this
# has to also cover the Binance withdrawal fee and a price-decay buffer for the
# transfer wait, not just both legs' taker fees.
TRANSFER_ARB_MIN_NET_SPREAD_PCT=0.02
TRANSFER_ARB_DECAY_BUFFER_PCT=0.005
# If the deposit lands and the spread has moved against the position by more than
# this, the agent does NOT auto-sell into the loss — it marks the position
# 'needs_manual_review' instead and waits for you to decide.
TRANSFER_ARB_MAX_ACCEPTABLE_LOSS_PCT=0.03
TRANSFER_ARB_MAX_CONCURRENT_POSITIONS=1
# How long to wait for a withdrawal to land on Coinbase before giving up and marking
# it 'stranded_after_withdrawal' for you to trace manually (block explorer / Binance
# withdrawal history) — the agent will not retry or guess.
TRANSFER_ARB_DEPOSIT_TIMEOUT_MS=7200000
TRANSFER_ARB_SCAN_INTERVAL_MS=10000
# ============================================================================

# Real agent health monitor: restarts (in place, same agent ID) any agent stuck in
# 'error' state for REAL_AGENT_MONITOR_ERROR_CYCLES consecutive checks.
REAL_AGENT_MONITOR_CHECK_INTERVAL_MS=600000
REAL_AGENT_MONITOR_ERROR_CYCLES=3

# "Race to survival" performance governor — reviews every real directional trading
# agent's REAL realized P&L on an interval, permanently stops ones with a sustained
# real loss (via agentCullService), and raises the budget cap of sustained real
# winners. Never acts on an agent still holding an open position, and never acts
# before enough closed trades exist to be a real signal rather than noise. This is
# the "managers kill underperforming agents" system.
PERFORMANCE_GOVERNOR_CHECK_INTERVAL_MS=1800000
PERFORMANCE_GOVERNOR_MIN_TRADES_FUTURES=8
PERFORMANCE_GOVERNOR_MIN_TRADES_PUMPFUN=5
PERFORMANCE_GOVERNOR_LOSS_THRESHOLD_PCT=0.5
PERFORMANCE_GOVERNOR_ELITE_THRESHOLD_PCT=0.5
PERFORMANCE_GOVERNOR_BOOST_FACTOR=1.5
PERFORMANCE_GOVERNOR_MAX_BUDGET_CAP_USD=100

# ============================================================================
# Fiat payments (paymentService.js) — real Stripe secret key, used by the gig/wallet
# payout paths (gigController, walletController, gigPaymentAutopilotService). Entirely
# separate system from the crypto trading agents above; only needed if you're using
# those fiat payout features. Leave unset/placeholder if you're not — nothing else in
# this app depends on it.
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Alternative fiat payment provider (paymentService.js supports either Stripe or
# PayPal, selected by PAYMENT_PROVIDER — 'stripe' is the default if unset). Same
# "only needed if using fiat payout features" caveat as Stripe above.
PAYMENT_PROVIDER=stripe
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX=true
